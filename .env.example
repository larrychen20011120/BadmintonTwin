# BadmintonTwin Environment Configuration
# Copy this file to .env and fill in local secrets.
# .env is loaded automatically by Utils.llm when LLM settings are resolved.

# Langfuse Self-Hosted Configuration
# Start the server first: docker compose -f docker-compose.langfuse.yaml up -d
# Then create a project at http://localhost:3000 and copy the API keys below.

LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_HOST=http://localhost:3000

# LLM switch:
#   BADMINTON_LLM_TYPE     = qwen, mistral, gemma
#   BADMINTON_LLM_PROVIDER = local, openrouter
BADMINTON_LLM_TYPE=qwen
BADMINTON_LLM_PROVIDER=local

# Local vLLM/OpenAI-compatible server
BADMINTON_LLM_API_KEY=EMPTY
BADMINTON_LLM_HOST=localhost
BADMINTON_LLM_PORT=16000
BADMINTON_LLM_BASE_URL=
BADMINTON_LLM_HOST_URL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSION=1536
OPENROUTER_QWEN_MODEL=qwen/qwen3.5-9b
OPENROUTER_MISTRAL_MODEL=mistralai/ministral-14b-2512
OPENROUTER_GEMMA_MODEL=google/gemma-3-12b-it
OPENROUTER_HTTP_REFERER=https://github.com
OPENROUTER_APP_TITLE=BadmintonTwin

# Twin embedding switch
BADMINTON_EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
LOCAL_EMBEDDING_DEVICE=auto
LOCAL_EMBEDDING_DIMENSION=1024
