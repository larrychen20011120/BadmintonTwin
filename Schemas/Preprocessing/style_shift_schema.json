    "required": [
      "dimension_level_shifts",
      "overall_style_shift_summary"
    ],
    "properties": {
      "dimension_level_shifts": {
        "type": "object",
        "required": ["physical_summary", "tactical_summary", "spatial_summary"],
        "properties": {
          "physical_summary": { "type": "string" },
          "tactical_summary": { "type": "string" },
          "spatial_summary": { "type": "string" }
        }
      },
      "overall_style_shift_summary": {
        "type": "string"
      }
    },
    "additionalProperties": false
}  