{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RagStage1GroundedResponse",
  "type": "object",
  "properties": {
    "case_assessments": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "source": {"type": "string", "enum": ["success", "miss"]},
          "retrieval_rank": {"type": "integer", "minimum": 1},
          "impact": {"type": "string", "enum": ["support", "conflict", "irrelevant"]},
          "factors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z]+(?:[-'][a-z]+)*(?: [a-z]+(?:[-'][a-z]+)*){0,3}$"
            }
          }
        },
        "required": ["source", "retrieval_rank", "impact", "factors"],
        "additionalProperties": false
      }
    },
    "outcome": {"type": "string", "enum": ["returned", "missed"]},
    "shot_type": {
      "type": ["string", "null"],
      "enum": ["Serve short", "Serve long", "Clear", "Push Shot", "Smash", "Smash Defence", "Drive", "Net Shot", "Lob", "Drop", null]
    }
  },
  "required": ["case_assessments", "outcome", "shot_type"],
  "additionalProperties": false
}
